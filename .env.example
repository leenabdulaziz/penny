# Required: your Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model + effort. Opus 5.5 at low effort is the default; claude-haiku-5-5 is the fastest option for snappier voice replies.
PENNY_MODEL=claude-opus-5-5
PENNY_EFFORT=low

# Optional: a much more natural voice via ElevenLabs. Without it, the browser's built-in voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

PORT=3000
