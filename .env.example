# Required: your Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model + effort. Opus 5.5 at low effort is the default; claude-haiku-5-5 is the fastest option for snappier voice replies.
PENNY_MODEL=claude-opus-5-5
PENNY_EFFORT=low

# Optional but recommended: a natural human voice via ElevenLabs (elevenlabs.io → Developers → API keys).
# Without it, the browser's built-in voice is used. If the key fails, Penny falls back automatically.
ELEVENLABS_API_KEY=
# Default voice if none is picked in Penny's settings (Lily, British, warm)
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
# eleven_flash_v2_5 = fastest; eleven_multilingual_v2 = most expressive but slower
ELEVENLABS_MODEL=eleven_flash_v2_5

PORT=3000
